{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Nachytej (spustit web)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/Nachytej/bin/Debug/net10.0/Nachytej.dll",
      "cwd": "${workspaceFolder}/src/Nachytej",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5057"
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      },
      "stopAtEntry": false,
      "console": "internalConsole"
    }
  ]
}
